{
  "compilerOptions": {
    "strict": true,
    "target": "ESDunelm",
    "module": "ESDunelm",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
